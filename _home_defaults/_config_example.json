{
    "_comment": "Full example config showing all supported Tuner features. Copy to ~/.tuner/config/config.json and adjust.",
    "provider": "antigravity",
    "model": "gemini-3.8-flash",
    "effort": "high",
    "language": "en",
    "user_timezone": "Asia/Seoul",
    "idle_timeout_minutes": 1440,
    "daily_reset_hour": 4,
    "daily_reset_enabled": false,
    "max_session_messages": null,
    "permission_mode": "bypassPermissions",
    "transport": "tg",
    "telegram_token": "YOUR_BOT_TOKEN_HERE",
    "allowed_user_ids": [123456789],
    "allowed_group_ids": [-1001234567890],
    "profiles": [
        {
            "name": "default"
        },
        {
            "name": "wife"
        }
    ],
    "heartbeat": {
        "enabled": true,
        "interval_minutes": 30,
        "quiet_start": 21,
        "quiet_end": 8,
        "ack_token": "HEARTBEAT_OK"
    },
    "cleanup": {
        "enabled": true,
        "media_files_days": 30,
        "output_to_user_days": 30,
        "check_hour": 3
    },
    "webhooks": {
        "enabled": false,
        "host": "127.0.0.1",
        "port": 8742,
        "token": "YOUR_WEBHOOK_SECRET",
        "max_body_bytes": 262144,
        "rate_limit_per_minute": 30
    },
    "cli_parameters": {
        "antigravity": []
    }
}
